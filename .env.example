# ─── Required everywhere ──────────────────────────────────────────────────────

# Signs Payload auth tokens. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs every admin user out.
PAYLOAD_SECRET=

# Public origin, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─── Database ─────────────────────────────────────────────────────────────────
# The adapter is chosen by which of these is set (see src/payload.config.ts).

# Local development: on-disk SQLite. Used only when POSTGRES_URL is absent.
DATABASE_URI=file:./hotpost.db

# Production: set this and Postgres is used instead. Vercel Postgres sets it
# automatically when you link a database to the project; with Neon, paste the
# pooled connection string.
# POSTGRES_URL=postgres://user:pass@host/db?sslmode=require


# ─── File uploads ─────────────────────────────────────────────────────────────
# Absent: Payload writes to public/media on disk (correct for local dev).
# Present: uploads go to Vercel Blob, which is required on Vercel because the
# filesystem there is not writable at runtime.
# Vercel injects this automatically once a Blob store is linked to the project.
# BLOB_READ_WRITE_TOKEN=
